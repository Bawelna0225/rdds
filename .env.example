# RDDS development environment
POSTGRES_DB=rdds
POSTGRES_USER=rdds
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_PASSWORD

# The API is exposed on the development LAN only at this stage.
RDDS_BIND_ADDRESS=0.0.0.0
RDDS_HTTP_PORT=8000
RDDS_WEB_BIND_ADDRESS=0.0.0.0
RDDS_WEB_PORT=8080
RDDS_ENVIRONMENT=development
RDDS_LOG_LEVEL=INFO
RDDS_INGEST_TOKEN=CHANGE_ME_TO_A_SECOND_RANDOM_PASSWORD
RDDS_SENSOR_OFFLINE_AFTER_SECONDS=30
RDDS_TRACK_POLL_SECONDS=1
RDDS_TRACK_STALE_AFTER_SECONDS=15
RDDS_TRACK_ENDED_AFTER_SECONDS=60
RDDS_TRACK_BATCH_SIZE=500

# Simulator defaults. Coordinates are synthetic and only used for development.
RDDS_SIM_CENTER_LAT=52.229700
RDDS_SIM_CENTER_LON=21.012200
RDDS_SIM_INTERVAL_SECONDS=2
