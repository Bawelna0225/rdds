# RDDS development environment
POSTGRES_DB=rdds
POSTGRES_USER=rdds
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_PASSWORD

# The API is exposed on the development LAN only at this stage.
RDDS_BIND_ADDRESS=0.0.0.0
RDDS_HTTP_PORT=8000
RDDS_WEB_BIND_ADDRESS=0.0.0.0
RDDS_WEB_PORT=8080
RDDS_ENVIRONMENT=development
RDDS_LOG_LEVEL=INFO
RDDS_INGEST_TOKEN=CHANGE_ME_TO_A_SECOND_RANDOM_PASSWORD
RDDS_ADMIN_TOKEN=CHANGE_ME_TO_A_THIRD_RANDOM_PASSWORD
# Keep true until every existing sensor has an individual token.
RDDS_ALLOW_LEGACY_INGEST=true
RDDS_SENSOR_OFFLINE_AFTER_SECONDS=30
RDDS_TRACK_POLL_SECONDS=1
RDDS_TRACK_STALE_AFTER_SECONDS=15
RDDS_TRACK_ENDED_AFTER_SECONDS=60
RDDS_TRACK_BATCH_SIZE=500
RDDS_ALERT_POLL_SECONDS=1

# Simulator defaults. Coordinates are synthetic and only used for development.
RDDS_SIM_CENTER_LAT=52.229700
RDDS_SIM_CENTER_LON=21.012200
RDDS_SIM_INTERVAL_SECONDS=2
# Optional JSON map used after issuing individual tokens to simulator sensors.
RDDS_SIM_SENSOR_TOKENS_JSON=

# Stage 9 Sky-Spy sensor agent. Register this sensor in the operator UI first,
# then place the one-time individual token only in the VM's ignored .env file.
RDDS_AGENT_SENSOR_ID=skyspy-sensor-01
RDDS_AGENT_DISPLAY_NAME=Sky-Spy development receiver
RDDS_AGENT_SENSOR_TOKEN=
# Optional fixed receiver position; set both values or leave both empty.
RDDS_AGENT_SENSOR_LAT=
RDDS_AGENT_SENSOR_LON=
RDDS_AGENT_TRANSPORT=unknown
RDDS_SKYSPY_BAUD_RATE=115200
RDDS_AGENT_HEARTBEAT_SECONDS=10
RDDS_AGENT_RECONNECT_SECONDS=3
RDDS_AGENT_REQUEST_TIMEOUT_SECONDS=5
RDDS_AGENT_MAX_QUEUE_MESSAGES=250000

# Hardware mode maps this host device into the agent container.
RDDS_SKYSPY_DEVICE=/dev/ttyACM0

# Synthetic Sky-Spy serial stream used before hardware arrives.
RDDS_SKYSPY_EMULATOR_INTERVAL_SECONDS=1
RDDS_SKYSPY_EMULATOR_CENTER_LAT=52.229700
RDDS_SKYSPY_EMULATOR_CENTER_LON=21.012200
