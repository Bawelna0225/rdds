# RDDS development environment
POSTGRES_DB=rdds
POSTGRES_USER=rdds
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_PASSWORD

# Keep the direct API bound to the VM. Browsers and remote sensors use the web
# proxy (HTTP development) or the TLS gateway (hardened deployment).
RDDS_BIND_ADDRESS=127.0.0.1
RDDS_HTTP_PORT=8000
RDDS_WEB_BIND_ADDRESS=0.0.0.0
RDDS_WEB_PORT=8080
RDDS_ENVIRONMENT=development
RDDS_LOG_LEVEL=INFO
RDDS_INGEST_TOKEN=CHANGE_ME_TO_A_SECOND_RANDOM_PASSWORD
# Keep true until every existing sensor has an individual token.
RDDS_ALLOW_LEGACY_INGEST=true
# Keep false only for local HTTP development. Set true behind HTTPS.
RDDS_SESSION_COOKIE_SECURE=false
RDDS_SESSION_IDLE_SECONDS=1800
RDDS_SESSION_ABSOLUTE_SECONDS=28800
RDDS_LOGIN_MAX_FAILURES=5
RDDS_LOGIN_LOCK_SECONDS=900
# Administrative warning when this many failed logins occur inside the window.
RDDS_SECURITY_FAILURE_WINDOW_MINUTES=15
RDDS_SECURITY_FAILURE_ALERT_COUNT=5
RDDS_SENSOR_OFFLINE_AFTER_SECONDS=30
# A live agent is degraded when its local delivery queue reaches this size.
RDDS_SENSOR_QUEUE_WARNING_MESSAGES=100
# Sky-Spy firmware reports an idle scanning status every 60 seconds.
RDDS_SENSOR_SOURCE_SILENT_AFTER_SECONDS=90
# Rolling source-quality window and warm-up period.
RDDS_SENSOR_QUALITY_WINDOW_SECONDS=60
RDDS_SENSOR_QUALITY_MIN_WINDOW_SECONDS=30
# Ignore-ratio evaluation starts after this many input lines.
RDDS_SENSOR_QUALITY_MIN_INPUT_LINES=20
RDDS_SENSOR_QUALITY_MAX_IGNORED_PERCENT=80
# Reconnects inside the rolling window that mark a source unstable.
RDDS_SENSOR_RECONNECT_WARNING_COUNT=3
RDDS_TRACK_POLL_SECONDS=1
RDDS_TRACK_STALE_AFTER_SECONDS=15
RDDS_TRACK_ENDED_AFTER_SECONDS=60
RDDS_TRACK_BATCH_SIZE=500
RDDS_ALERT_POLL_SECONDS=1

# Operational backup. Create this directory before starting Compose and make it
# writable by RDDS_OPERATIONS_UID/GID. Copy backups to another machine or medium.
RDDS_OPERATIONS_UID=1000
RDDS_OPERATIONS_GID=1000
RDDS_BACKUP_PATH=/opt/rdds/backups
RDDS_BACKUP_INTERVAL_SECONDS=86400
RDDS_BACKUP_RETENTION_DAYS=30

# Database retention is deliberately off during the upgrade. Run the documented
# dry run and verify an independent backup before changing this to true.
RDDS_RETENTION_ENABLED=false
RDDS_MAINTENANCE_INTERVAL_SECONDS=86400
RDDS_RETENTION_BATCH_SIZE=10000
RDDS_RETENTION_SESSIONS_DAYS=30
RDDS_RETENTION_SECURITY_EVENTS_DAYS=180
RDDS_RETENTION_HEARTBEATS_DAYS=30
RDDS_RETENTION_OBSERVATIONS_DAYS=90
RDDS_RETENTION_AUDIT_DAYS=365
RDDS_RETENTION_ALERTS_DAYS=365
RDDS_RETENTION_TRACKS_DAYS=365

# Optional administrative storage budget. Zero shows the measured database size
# without calculating a potentially misleading percentage. Set the usable
# budget reserved for PostgreSQL to enable the usage meter.
RDDS_DATABASE_CAPACITY_GB=0
RDDS_DATABASE_WARNING_PERCENT=70
RDDS_DATABASE_CRITICAL_PERCENT=85

# Optional TLS profile. The certificate paths are host paths. Set the gateway
# UID/GID to the owner of files that are readable only by that account.
RDDS_HTTPS_BIND_ADDRESS=0.0.0.0
RDDS_HTTPS_PORT=8443
RDDS_GATEWAY_UID=1000
RDDS_GATEWAY_GID=1000
RDDS_TLS_CERT_FILE=/opt/rdds/tls/tls.crt
RDDS_TLS_KEY_FILE=/opt/rdds/tls/tls.key

# Simulator defaults. Coordinates are synthetic and only used for development.
RDDS_SIM_CENTER_LAT=52.229700
RDDS_SIM_CENTER_LON=21.012200
RDDS_SIM_INTERVAL_SECONDS=2
# Optional JSON map used after issuing individual tokens to simulator sensors.
RDDS_SIM_SENSOR_TOKENS_JSON=

# Stage 9 Sky-Spy sensor agent. Register this sensor in the operator UI first,
# then place the one-time individual token only in the VM's ignored .env file.
RDDS_AGENT_SENSOR_ID=skyspy-sensor-01
RDDS_AGENT_DISPLAY_NAME=Sky-Spy development receiver
RDDS_AGENT_SENSOR_TOKEN=
# Optional fixed receiver position; set both values or leave both empty.
RDDS_AGENT_SENSOR_LAT=
RDDS_AGENT_SENSOR_LON=
RDDS_AGENT_TRANSPORT=unknown
RDDS_SKYSPY_BAUD_RATE=115200
RDDS_AGENT_HEARTBEAT_SECONDS=10
RDDS_AGENT_RECONNECT_SECONDS=3
RDDS_AGENT_REQUEST_TIMEOUT_SECONDS=5
RDDS_AGENT_REPLAY_MESSAGES_PER_SECOND=2
RDDS_AGENT_MAX_QUEUE_MESSAGES=250000

# Hardware mode maps this host device into the agent container.
RDDS_SKYSPY_DEVICE=/dev/ttyACM0

# Synthetic Sky-Spy serial stream used before hardware arrives.
RDDS_SKYSPY_EMULATOR_INTERVAL_SECONDS=1
RDDS_SKYSPY_EMULATOR_CENTER_LAT=52.229700
RDDS_SKYSPY_EMULATOR_CENTER_LON=21.012200
# Stage 18 diagnostic modes: normal, silent, malformed or disconnect.
RDDS_SKYSPY_EMULATOR_FAULT_MODE=normal
RDDS_SKYSPY_EMULATOR_DISCONNECT_AFTER_MESSAGES=20
